# Language Learning Backend Environment Variables

# Database Configuration (Defaults configured in application.properties for port 5433 or 5432)
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/language_learning
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security / JWT Secret (Required in production, min 256-bit / 32 bytes base64 or raw string)
