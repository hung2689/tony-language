# Language Learning Backend Environment Variables

# Database Configuration (Committed defaults: localhost:5432)
# If your local PostgreSQL runs on a different port (e.g., 5433), set DB_PORT=5433
DB_HOST=localhost
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/language_learning
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security / JWT Secret (Required in production and non-dev profiles, minimum 256-bit / 32 bytes)
# Generate a real secret with:
#   Linux/macOS/Git Bash: openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 } | ForEach-Object { [byte]$_ }))
# The placeholder below will be rejected by the startup guard in non-dev profiles.
JWT_SECRET=REPLACE_ME_GENERATE_WITH_OPENSSL

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
