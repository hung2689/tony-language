# Language Learning Backend Environment Variables

# --- Local Development Defaults ---
DB_HOST=localhost
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/language_learning
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=REPLACE_ME_GENERATE_WITH_OPENSSL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production Configuration (Render / Neon) ---
# Active Profile: prod
# SPRING_PROFILES_ACTIVE=prod
#
# Render port (injected automatically by Render):
# PORT=8080
#
# Neon PostgreSQL JDBC Connection:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>:5432/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-role>
# SPRING_DATASOURCE_PASSWORD=<neon-password>
#
# Connection Pool Size (default 5 for Render Free + Neon Free):
# DB_POOL_MAX=5
#
# JWT Secret (minimum 256-bit / 32 bytes):
# JWT_SECRET=<openssl rand -base64 32>
#
# CORS Allowed Origins (Comma-separated HTTPS origins of your frontend):
# CORS_ALLOWED_ORIGINS=https://<your-frontend>.vercel.app
#
# Cookie SameSite setting for cross-origin HTTPS requests:
# APP_COOKIE_SAME_SITE=None
